{
  "name": "out-past",
  "productName": "Out Past",
  "version": "1.3.0",
  "description": "A calm, white, Claude-style Mac focus and mission app with a fully local AI mentor (KAI).",
  "author": "Kidus Tefeta",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run bake:google && npm run build:renderer && electron-builder --mac",
    "build:win": "npm run bake:google && npm run build:renderer && electron-builder --win --publish never",
    "pack": "npm run build:renderer && electron-builder --mac dir",
    "set-creds": "node scripts/set-creds.cjs",
    "bake:google": "node scripts/bake-google.cjs"
  },
  "dependencies": {
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.outpast.app",
    "productName": "Out Past",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "build/afm",
          "to": "afm"
        },
        {
          "from": "build/kai",
          "to": "kai"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/kai",
          "to": "kai"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Out Past",
      "artifactName": "OutPast-Setup.exe"
    }
  }
}
